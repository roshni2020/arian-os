# Copy to .env (never commit .env). The worker also reads WANDB_API_KEY from the Windows per-user environment.
WANDB_API_KEY=
WANDB_ENTITY=ali-amjad52114-r42
WANDB_PROJECT=wildfire-autonomous-researcher
# connected = real ARIA via W&B Automations + Artifacts (the only judged mode)
# fallback  = development-only scripted stub, always labelled, never silent
ARIA_MODE=connected
EXPERIMENT_BUDGET=15
ARIA_WAIT_SECONDS=1800
ARIA_POLL_SECONDS=15
ARIA_MAX_REJECTIONS=3
# W&B sometimes drops a run-finished event; after this many seconds without an ARIA reply the worker
# re-publishes the state through a control run (up to ARIA_MAX_NUDGES times). ARIA normally replies in 60-90 s.
ARIA_NUDGE_SECONDS=180
ARIA_MAX_NUDGES=2
FAST_MODE=false
# Optional overrides
# WILDFIREIA_DIR=./WildfireIA
# RESEARCHER_DB_PATH=./data/researcher.sqlite
# BACKEND_URL=http://127.0.0.1:8000   (frontend rewrite target)
